<Window x:Class="PadTas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PadTas.App.Controls"
        Title="PadTAS - コントローラー TAS レコーダー" Width="1060" Height="740"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="40" Height="40">
                    <Border Background="#4F7CFF" CornerRadius="10">
                        <TextBlock Text="🎮" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="HeaderIcon" Width="40" Height="40"/>
                </Grid>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="PadTAS" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="コントローラー TAS レコーダー" FontSize="11.5" Foreground="#C9CCDB"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="DriverButton" Content="ドライバ確認中…" Click="DriverButton_Click"/>
                <Button Content="アップデート確認" Margin="8,0,0,0" Click="CheckUpdate_Click"/>
            </StackPanel>
        </Grid>

        <!-- プロジェクト -->
        <Border Grid.Row="1" Background="#1E2026" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="プロジェクト" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBox x:Name="ProjectFolderBox" Width="480" IsReadOnly="True" VerticalAlignment="Center"/>
                <Button Content="フォルダを選ぶ" Margin="10,0,0,0" Click="ChooseFolder_Click"/>
                <TextBlock Text="コントローラー" VerticalAlignment="Center" Margin="22,0,8,0"/>
                <ComboBox x:Name="ControllerBox" Width="70" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="#0"/><ComboBoxItem Content="#1"/>
                    <ComboBoxItem Content="#2"/><ComboBoxItem Content="#3"/>
                </ComboBox>
                <TextBlock Text="ポーリング" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="PollingBox" Width="105" SelectedIndex="2" VerticalAlignment="Center">
                    <ComboBoxItem Content="250 Hz"/>
                    <ComboBoxItem Content="500 Hz"/>
                    <ComboBoxItem Content="1000 Hz"/>
                    <ComboBoxItem Content="2000 Hz"/>
                    <ComboBoxItem Content="4000 Hz"/>
                    <ComboBoxItem Content="8000 Hz"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- メイン: 左=コントローラー表示 / 右=セグメント -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E2026" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="現在の入力" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                    <TextBlock Text="記録中・再生中はその入力、待機中は実コントローラーの入力をそのまま表示します"
                               Foreground="#B4B9CC" FontSize="11" Margin="0,2,0,6"/>
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                        <controls:GamepadView x:Name="PadView"/>
                    </Viewbox>
                    <TextBlock x:Name="LiveStateText" FontFamily="Consolas" FontSize="12.5" Margin="2,8,0,0"
                               Text="Buttons: 0000   LX: 0  LY: 0   RX: 0  RY: 0   LT: 0  RT: 0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E2026" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="記録した入力 (セグメント)" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="上から順に連結して再生されます" Foreground="#B4B9CC" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="SegmentList" Grid.Row="1"/>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="DeleteSegmentButton" Style="{StaticResource DangerButton}"
                                Content="🗑 選択した入力を削除" Click="DeleteSegment_Click"/>
                        <Button x:Name="DeleteAllButton" Style="{StaticResource DangerButton}"
                                Content="全ての入力を削除" Margin="0,8,0,0" Click="DeleteAll_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,10">
            <Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}"
                    Content="● 記録開始 (続きに追加)" Width="210" Height="42" FontSize="14"
                    Click="Record_Click"/>
            <Button x:Name="StopRecordButton" Content="■ 停止して保存" Width="150" Height="42"
                    Margin="10,0,0,0" IsEnabled="False" Click="StopRecord_Click"/>
            <Button Content="▶ 全セグメント再生" Width="180" Height="42" Margin="10,0,0,0"
                    Click="Play_Click"/>
            <Button Content="⏹ 再生停止" Width="120" Height="42" Margin="10,0,0,0"
                    Click="StopPlay_Click"/>
        </StackPanel>

        <!-- ステータス -->
        <Border Grid.Row="4" Background="#1E2026" CornerRadius="10" Padding="12,8">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C9CCDB"
                       Text="プロジェクトフォルダを選んでください。"/>
        </Border>
    </Grid>
</Window>
