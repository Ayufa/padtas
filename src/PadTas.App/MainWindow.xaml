<Window x:Class="PadTas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadTAS - コントローラー TAS レコーダー" Width="720" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- プロジェクト -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="プロジェクト:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ProjectFolderBox" Width="380" IsReadOnly="True"/>
            <Button Content="フォルダを選ぶ" Margin="6,0,0,0" Click="ChooseFolder_Click"/>
            <Button Content="アップデート確認" Margin="6,0,0,0" Click="CheckUpdate_Click"/>
        </StackPanel>

        <!-- 記録設定 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="コントローラー:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ControllerBox" Width="70" SelectedIndex="0">
                <ComboBoxItem Content="#0"/><ComboBoxItem Content="#1"/>
                <ComboBoxItem Content="#2"/><ComboBoxItem Content="#3"/>
            </ComboBox>
            <TextBlock Text="ポーリング:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="PollingBox" Width="110" SelectedIndex="2">
                <ComboBoxItem Content="250 Hz"/>
                <ComboBoxItem Content="500 Hz"/>
                <ComboBoxItem Content="1000 Hz"/>
                <ComboBoxItem Content="2000 Hz"/>
            </ComboBox>
            <TextBlock x:Name="LiveStateText" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" Text="Buttons: 0000  LX: 0  LY: 0  LT: 0"/>
        </StackPanel>

        <!-- セグメント一覧 -->
        <GroupBox Grid.Row="2" Header="セグメント (この順番で連結再生されます)">
            <ListBox x:Name="SegmentList"/>
        </GroupBox>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="RecordButton" Content="● 記録開始 (続きに追加)" Width="180" Height="34"
                    Click="Record_Click"/>
            <Button x:Name="StopRecordButton" Content="■ 停止して保存" Width="130" Height="34"
                    Margin="8,0,0,0" IsEnabled="False" Click="StopRecord_Click"/>
            <Button Content="▶ 全セグメント再生" Width="150" Height="34" Margin="8,0,0,0"
                    Click="Play_Click"/>
            <Button Content="⏹ 再生停止" Width="100" Height="34" Margin="8,0,0,0"
                    Click="StopPlay_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" TextWrapping="Wrap"
                   Text="プロジェクトフォルダを選んでください。"/>
    </Grid>
</Window>
